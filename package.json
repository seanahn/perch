{
  "name": "perch",
  "displayName": "Perch",
  "description": "Claude Code and Codex agents as tabs in one sidebar. Any number of sessions. A shell, not an agent.",
  "version": "0.2.0",
  "publisher": "fennets",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "perch",
          "title": "Perch",
          "icon": "media/perch.svg"
        }
      ]
    },
    "views": {
      "perch": [
        {
          "type": "webview",
          "id": "perch.main",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "perch.newClaude",
        "title": "Perch: New Claude Tab",
        "icon": "$(add)"
      },
      {
        "command": "perch.newCodex",
        "title": "Perch: New Codex Tab",
        "icon": "$(add)"
      },
      {
        "command": "perch.stop",
        "title": "Perch: Stop Active Tab",
        "icon": "$(debug-stop)"
      },
      {
        "command": "perch.closeTab",
        "title": "Perch: Close Active Tab",
        "icon": "$(close)"
      },
      {
        "command": "perch.handoff",
        "title": "Perch: Hand Off Last Answer to Another Tab\u2026",
        "icon": "$(arrow-swap)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "perch.handoff",
          "when": "view == perch.main",
          "group": "navigation@1"
        },
        {
          "command": "perch.stop",
          "when": "view == perch.main",
          "group": "navigation@2"
        },
        {
          "command": "perch.newClaude",
          "when": "view == perch.main",
          "group": "1_new@1"
        },
        {
          "command": "perch.newCodex",
          "when": "view == perch.main",
          "group": "1_new@2"
        },
        {
          "command": "perch.closeTab",
          "when": "view == perch.main",
          "group": "1_new@3"
        }
      ]
    },
    "configuration": {
      "title": "Perch",
      "properties": {
        "perch.claude.permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "auto",
            "bypassPermissions"
          ],
          "default": "default",
          "description": "Claude Code permission mode for new tabs. bypassPermissions skips all prompts."
        },
        "perch.claude.model": {
          "type": "string",
          "default": "",
          "description": "Claude model id for new sessions. Empty uses Claude Code's default."
        },
        "perch.claude.effort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "description": "Claude reasoning effort for new tabs. Empty uses the model's default. Each tab can change it live."
        },
        "perch.claude.executable": {
          "type": "string",
          "default": "",
          "description": "Path to a claude CLI to use instead of the one bundled with the Agent SDK."
        },
        "perch.codex.approvalPolicy": {
          "type": "string",
          "enum": [
            "never",
            "on-request",
            "on-failure",
            "untrusted"
          ],
          "default": "on-failure",
          "description": "Codex approval policy. The Codex SDK runs non-interactively, so approvals resolve by policy, not by prompt."
        },
        "perch.codex.sandboxMode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "default": "workspace-write",
          "description": "Codex sandbox mode for new tabs."
        },
        "perch.codex.model": {
          "type": "string",
          "default": "",
          "description": "Codex model id for new threads. Empty uses Codex's default."
        },
        "perch.codex.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "",
          "description": "Codex reasoning effort for new tabs. Empty uses Codex's default. Set per tab before its first message."
        }
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@openai/codex-sdk": "^0.159.0"
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/claudeAgent.js && node --check src/codexAgent.js && node --check src/webview.js && node --check test/host.test.js && node --check test/page.test.js",
    "test": "node test/host.test.js && node test/page.test.js && node test/harness.mjs",
    "package": "vsce package",
    "test:offline": "node test/host.test.js && node test/page.test.js"
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  }
}
